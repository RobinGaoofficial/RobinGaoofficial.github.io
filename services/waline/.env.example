# Registration verification and password reset need SMTP.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SENDER_NAME=高彬斌的博客
SENDER_EMAIL=
AUTHOR_EMAIL=
